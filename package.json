{
  "name": "sahadeva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/scrub-build-secrets.mjs",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:scan": "node scripts/check-secrets.mjs",
    "budget": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run check && npm test && npm run security:scan && npm run build && npm run budget",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "fixtures:lunar": "node scripts/generate-lunar-boundary-fixtures.mjs",
    "fixtures:panchanga": "node scripts/generate-panchanga-transition-fixtures.mjs",
    "fixtures:vsop87": "node scripts/generate-vsop87-truncated.mjs",
    "knowledge:catalog": "node scripts/build-knowledge-catalog.mjs",
    "knowledge:chunks": "node scripts/build-knowledge-chunks.mjs",
    "knowledge:books": "node scripts/build-book-coverage.mjs",
    "knowledge:books:verify": "node scripts/verify-book-coverage.mjs",
    "knowledge:books:sections": "node scripts/build-book-section-migration.mjs",
    "knowledge:books:fixtures": "node scripts/export-book-rule-fixtures.mjs",
    "knowledge:lal-kitab": "node scripts/build-lal-kitab-manifest.mjs",
    "knowledge:lal-kitab:sections": "node scripts/build-lal-kitab-section-migration.mjs",
    "migrations:verify": "node scripts/verify-migrations.mjs",
    "mobile:verify": "npm --prefix ios-app run lint && npm --prefix ios-app exec tsc -- --noEmit && npm --prefix ios-app exec expo export -- --platform web",
    "locations:geonames": "node scripts/import-geonames.mjs",
    "report:sample": "node scripts/generate-client-report-sample.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "latest",
    "@resvg/resvg-wasm": "^2.6.2",
    "astronomia": "^4.2.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "latest",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.62.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
