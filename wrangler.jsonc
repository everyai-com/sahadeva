{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahadeva",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/.well-known/*"],
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "CALC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sahadeva",
      "database_id": "422d3a03-089f-4d8d-aacc-fb0a465d6011",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["0,30 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "ENGINE_VERSION": "cleanroom-0.15.0",
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "AI_CHAT_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
  },
}
